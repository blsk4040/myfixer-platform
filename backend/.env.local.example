# MyFixer backend local development
NODE_ENV=development
PORT=5000
JSON_BODY_LIMIT=8mb

# Use a development/staging MongoDB Atlas database, not production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dev-db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-local-secret

# Local admin portal and mobile device origins.
ADMIN_PORTAL_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173,http://192.168.3.34:4173,http://192.168.3.34:19000

# Optional services. Leave blank locally if not testing these flows.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PAYSTACK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis is optional and disabled by default.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Local-only operational helpers.
TECHNICIAN_AUTO_APPROVE=false
