# Padi backend production
NODE_ENV=production
APP_ENV=production
PORT=5000
JSON_BODY_LIMIT=8mb

# Store these in the deployment provider secret manager. Do not commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<prod-db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-production-secret-at-least-48-characters
ADMIN_SETUP_KEY=replace-with-one-time-super-admin-setup-key

# Production public URLs.
API_BASE_URL=https://api.hellopadi.com/api/v1
SOCKET_URL=https://api.hellopadi.com
ADMIN_PORTAL_URL=https://admin.hellopadi.com
CORS_ORIGINS=https://www.hellopadi.com,https://admin.hellopadi.com,https://myfixer-platform.onrender.com,https://myfixer-admin.onrender.com

# Email delivery.
RESEND_API_KEY=replace-with-resend-production-key
RESEND_FROM_EMAIL=onboarding@hellopadi.com

# Google auth.
GOOGLE_WEB_CLIENT_ID=replace-with-production-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace-with-production-android-client-id.apps.googleusercontent.com

# Service and profile image uploads.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Payments.
PAYSTACK_ENABLED=true
PAYSTACK_SECRET_KEY=replace-with-paystack-live-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-paystack-live-public-key
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TRANSFERS_ENABLED=false

# Enable Redis only if a production feature needs it.
REDIS_ENABLED=false
REDIS_URL=

TECHNICIAN_AUTO_APPROVE=false

# Routing.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=replace-with-production-routing-url
