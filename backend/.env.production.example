# MyFixer backend production
NODE_ENV=production
PORT=5000

# Store these in the deployment provider secret manager. Do not commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<prod-db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-production-secret

# Production public URLs.
ADMIN_PORTAL_URL=https://admin.myfixer.co.za
CORS_ORIGINS=https://admin.myfixer.co.za

# Email and payment providers.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=MyFixer <no-reply@myfixer.co.za>
PAYSTACK_SECRET_KEY=sk_live_...

# Enable Redis only if a production feature needs it.
REDIS_ENABLED=false
REDIS_URL=

TECHNICIAN_AUTO_APPROVE=false
