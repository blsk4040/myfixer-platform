{
  "name": "myfixer-backend",
  "version": "1.0.0",
  "description": "MyFixer on-demand appliance repair backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../config/run-with-platform-env.js tsx watch src/server.ts",
    "build": "node ../config/run-with-platform-env.js tsc",
    "start": "node ../config/run-with-platform-env.js node dist/server.js",
    "test": "node ../config/run-with-platform-env.js node scripts/production-smoke-test.js",
    "test:routing": "node ../config/run-with-platform-env.js tsx scripts/routing-module-test.ts",
    "test:workflow": "node ../config/run-with-platform-env.js tsx scripts/booking-workflow-test.ts",
    "test:privacy": "node ../config/run-with-platform-env.js tsx scripts/booking-recipient-privacy-test.ts",
    "test:inspection-quote": "node ../config/run-with-platform-env.js tsx scripts/inspection-quote-test.ts",
    "test:payments": "node ../config/run-with-platform-env.js tsx scripts/payment-security-test.ts",
    "test:support": "node ../config/run-with-platform-env.js tsx scripts/support-foundation-test.ts",
    "test:promotions": "node ../config/run-with-platform-env.js tsx scripts/promotion-campaign-test.ts",
    "test:settlements": "node ../config/run-with-platform-env.js tsx scripts/settlement-lifecycle-test.ts",
    "test:payouts": "node ../config/run-with-platform-env.js tsx scripts/payouts-test.ts",
    "test:country-payments": "node ../config/run-with-platform-env.js tsx scripts/country-payments-test.ts",
    "test:markets": "node ../config/run-with-platform-env.js tsx scripts/market-lifecycle-test.ts",
    "test:services": "node ../config/run-with-platform-env.js tsx scripts/service-catalog-test.ts",
    "test:markets:staging": "node ../config/run-with-platform-env.js tsx scripts/market-lifecycle-staging-test.ts",
    "audit:market-codes": "node ../config/run-with-platform-env.js tsx scripts/audit-market-code-normalization.ts",
    "fix:market-country-index": "node ../config/run-with-platform-env.js tsx scripts/fix-market-country-index.ts",
    "backfill:service-hierarchy": "node ../config/run-with-platform-env.js tsx scripts/backfill-service-hierarchy.ts",
    "typecheck": "node ../config/run-with-platform-env.js tsc --noEmit",
    "reconcile:paystack": "node ../config/run-with-platform-env.js tsx scripts/reconcile-paystack-payments.ts --dry-run",
    "reconcile:settlements": "node ../config/run-with-platform-env.js tsx scripts/reconcile-settlements.ts --dry-run",
    "reconcile:payouts": "node ../config/run-with-platform-env.js tsx scripts/reconcile-payouts.ts --dry-run",
    "seed:staging": "node ../config/run-with-platform-env.js node scripts/seed-staging.js",
    "seed:test-tech-capability": "node ../config/run-with-platform-env.js node scripts/seed-tech-capability.js",
    "cleanup:staging": "node ../config/run-with-platform-env.js node scripts/cleanup-staging.js",
    "create:super-admin": "node scripts/create-super-admin.js",
    "reset-admin-password": "node scripts/reset-admin-password.js"
  },
  "keywords": [
    "myfixer",
    "appliance-repair",
    "express",
    "socket.io",
    "postgis"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.1",
    "morgan": "^1.11.0",
    "resend": "^6.16.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
