{
  "expo": {
    "name": "Padi",
    "slug": "myfixer-client",
    "scheme": "myfixerclient",
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "co.za.myfixer.client"
    },
    "android": {
      "package": "co.za.myfixer.client",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "notification": {
      "icon": "./src/assets/logo/56 PM.png",
      "color": "#B8FF3D"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Padi to show your position relative to the assigned professional on the live map."
        }
      ]
    ]
  }
}
